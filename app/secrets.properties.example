# Copy this file to app/secrets.properties (gitignored) and fill in the blanks.
# These values are baked into BuildConfig at build time (see app/build.gradle).
# The companion MoveInSync driver (mis_book.py) talks to the SAME MQTT broker.

broker_host=172.20.1.100
broker_port=1883
broker_user=
broker_pass=
mqtt_base=screenbridge
http_port=8080
# Optional shared secret; when set, every HTTP request needs header X-Bridge-Token: <token>
auth_token=
